<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ProductName>ETStock</ProductName>
    <Manufacturer>ETStock</Manufacturer>
    <Version>1.0.0.0</Version>
    <UpgradeCode>4166FA39-65F5-4C96-A223-267DE58EACD5</UpgradeCode>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ApplicationFolderName>ETStock</ApplicationFolderName>
    <!-- suppress ICE60 warning for font-related files without Language column -->
    <SuppressIces>ICE60</SuppressIces>
    <!-- ชี้ไปที่ publish output -->
    <PublishDir>$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <Platforms>x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>