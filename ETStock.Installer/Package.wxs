<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="ETStock"
           Manufacturer="ETStock"
           Version="1.0.1"
           UpgradeCode="4166FA39-65F5-4C96-A223-267DE58EACD5"
           Language="1033"
           Codepage="utf-8"
           Compressed="yes"
           Scope="perMachine">

    <SummaryInformation Description="ETStock Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed. Please uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="ProductFeature" Title="ETStock" Level="1">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>

  </Package>

  <!-- Directory structure -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ETStock" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ETStock" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- Start Menu and Desktop shortcuts -->
  <Fragment>
    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ETStock"
                  Description="ETStock Stock Management"
                  Target="[INSTALLFOLDER]ETStock.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ETStockIcon" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall ETStock"
                  Description="Uninstall ETStock"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU"
                       Key="Software\ETStock"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="CleanupApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
      </Component>
    </ComponentGroup>

    <Component Id="ApplicationShortcutDesktop" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="ApplicationDesktopShortcut"
                Name="ETStock"
                Description="ETStock Stock Management"
                Target="[INSTALLFOLDER]ETStock.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="ETStockIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\ETStock"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- Icon -->
  <Fragment>
    <Icon Id="ETStockIcon" SourceFile="..\ETStock\Assets\etstock.ico" />
  </Fragment>

</Wix>
