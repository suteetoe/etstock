<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ic="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
		xmlns:icx="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
		xmlns:vm="using:ETStock.ViewModels"
		x:Class="ETStock.Views.PeriodSelectorWindow"
		x:DataType="vm:PeriodSelectorViewModel"
		Icon="avares://ETStock/Assets/etstock.ico"
		Title="เลือกงวด (ปี / เดือน)"
		Width="400" Height="180"
		WindowStartupLocation="CenterScreen"
		CanResize="False"
		ShowInTaskbar="True" Background="{DynamicResource AppBackgroundBrush}" >



	<Grid RowDefinitions="*,Auto" Margin="16" >
		<StackPanel Grid.Row="0" Spacing="8">
			<TextBlock Text="เลือกเดือน / ปี" FontWeight="SemiBold"/>
			<DatePicker SelectedDate="{Binding SelectedDate}"
						DayVisible="False"
						HorizontalAlignment="Stretch"/>
		</StackPanel>

		<Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="0,16,0,0">

			<Button Classes="danger"  Grid.Column="0" HorizontalAlignment="Stretch"
					 Command="{Binding CancelCommand}">

				<StackPanel Orientation="Horizontal" >
					<ic:FluentIcon Icon="DismissCircle" />
					<TextBlock Text=" ยกเลิก" />
				</StackPanel>
			</Button>
			<Button  Classes="success" Grid.Column="2" HorizontalAlignment="Stretch"
					Command="{Binding ConfirmCommand}">
				<StackPanel Orientation="Horizontal">
					<ic:FluentIcon Icon="CheckmarkCircle" />
					<TextBlock Text=" ตกลง" />
				</StackPanel>
			</Button>
		</Grid>
	</Grid>
</Window>
