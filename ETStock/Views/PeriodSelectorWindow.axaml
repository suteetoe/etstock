<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ETStock.ViewModels"
        x:Class="ETStock.Views.PeriodSelectorWindow"
        x:DataType="vm:PeriodSelectorViewModel"
        Title="เลือกงวด (ปี / เดือน)"
        Width="400" Height="180"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="เลือกเดือน / ปี" FontWeight="SemiBold"/>
            <DatePicker SelectedDate="{Binding SelectedDate}"
                        DayVisible="False"
                        HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="ยกเลิก" HorizontalAlignment="Stretch"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="2" Content="ตกลง" HorizontalAlignment="Stretch"
                    Classes="accent" Command="{Binding ConfirmCommand}"/>
        </Grid>
    </Grid>
</Window>
