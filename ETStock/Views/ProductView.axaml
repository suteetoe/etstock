<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:ETStock.ViewModels"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ic="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
			 xmlns:icx="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
			 x:Class="ETStock.Views.ProductView"
			 x:DataType="vm:ProductViewModel" >

	<Design.DataContext>
		<vm:ProductViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" >

		<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="ยอดสินค้าคงเหลือ"
					   FontSize="24"
					   FontWeight="Bold"/>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<Button Command="{Binding DeleteProductCommand}"
						Classes="danger"
						IsEnabled="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">

					<StackPanel Orientation="Horizontal" >
						<ic:FluentIcon Icon="DismissCircle" />
						<TextBlock Text=" ลบสินค้า"  Padding="0,2,0,0" />
					</StackPanel>
				</Button>
				<Button
				Command="{Binding AddProductCommand}"
				Classes="success" >
					<StackPanel Orientation="Horizontal" >
						<ic:FluentIcon Icon="AddCircle" />
						<TextBlock Text=" เพิ่มสินค้า"  Padding="0,2,0,0" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>


		<DockPanel Grid.Row="1" LastChildFill="False">
			<StackPanel Orientation="Horizontal" Spacing="8" >
				<TextBlock Text="ค้นหา : " Margin="5,10,0,0" />
				<TextBox Text="{Binding SearchText}"
						 Watermark="ค้นหาชื่อสินค้า..."  Padding="5,10,0,0"
						 Width="400"
						 >
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding SearchProductCommand}"/>
					</TextBox.KeyBindings>
				</TextBox>
			</StackPanel>
			<StackPanel  Orientation="Horizontal" Spacing="8"  DockPanel.Dock="Right" >

				<Button
				Command="{Binding SaveCommand}"
				Classes="accent"
				IsEnabled="{Binding !IsBusy}" >

					<StackPanel Orientation="Horizontal" >
						<ic:FluentIcon Icon="Save" />
						<TextBlock Text=" บันทีกข้อมูล"  Padding="0,2,0,0" />
					</StackPanel>
				</Button>
				<Button
				Command="{Binding ExportExcelCommand}"
				Classes="info"
				IsEnabled="{Binding !IsBusy}" >
					<StackPanel Orientation="Horizontal" >
						<ic:FluentIcon Icon="DocumentSave" />
						<TextBlock Text=" ส่งออกเป็น Excel"  Padding="0,2,0,0" />
					</StackPanel>
				</Button>
				<Button
				Command="{Binding GenerateInvoicesCommand}"
				Classes="accent"
				IsEnabled="{Binding !IsBusy}">
					<StackPanel Orientation="Horizontal" >
						<ic:FluentIcon Icon="DocumentOnePageSparkle" />
						<TextBlock Text=" สร้างใบกำกับภาษีอย่างย่อ"  Padding="0,2,0,0" />
					</StackPanel>
				</Button>
			</StackPanel>
		</DockPanel>



		<Border Grid.Row="2"
				Background="{DynamicResource SurfaceBrush}"
				BorderBrush="{DynamicResource PanelBorderBrush}"
				BorderThickness="1"
				CornerRadius="4">
			<ScrollViewer HorizontalScrollBarVisibility="Auto"
						  VerticalScrollBarVisibility="Disabled">
				<Grid RowDefinitions="Auto,*,Auto" MinWidth="1300">

					<!-- Sticky Header -->
					<Border Grid.Row="0" Background="{DynamicResource TableHeaderBrush}" Padding="8">
						<Grid ColumnDefinitions="*,18">
							<Grid ColumnDefinitions="40,*,90,90,90,90,90,110,90,110,150"
								  ColumnSpacing="8">
								<TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold"/>
								<TextBlock Grid.Column="1" Text="ชื่อสินค้า" FontWeight="SemiBold"/>
								<TextBlock Grid.Column="2" Text="ยอดยกมา" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="3" Text="ซื้อ" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="4" Text="ขายออก" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="5" Text="บิลเต็ม" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="6" Text="คงเหลือ" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="7" Text="ต้นทุนสินค้า" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="8" Text="ราคาขาย" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="9" Text="จำนวนเงิน" FontWeight="SemiBold" TextAlignment="Right"/>
								<TextBlock Grid.Column="10" Text="มูลค่าสินค้าคงเหลือ" FontWeight="SemiBold" TextAlignment="Right"/>
							</Grid>
						</Grid>
					</Border>

					<!-- Scrollable Rows (vertical only) -->
					<ScrollViewer Grid.Row="1"
								  HorizontalScrollBarVisibility="Disabled"
								  VerticalScrollBarVisibility="Auto">
						<ListBox x:Name="ProductListBox"
								 ItemsSource="{Binding Rows}"
								 SelectedItem="{Binding SelectedRow}"
								 SelectionMode="Single"
								 Background="Transparent"
								 BorderThickness="0">
							<ListBox.ItemContainerTheme>
								<ControlTheme TargetType="ListBoxItem">
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Background" Value="Transparent"/>
								</ControlTheme>
							</ListBox.ItemContainerTheme>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:MonthlyStockRowViewModel">
									<Border BorderBrush="{DynamicResource RowDividerBrush}"
											BorderThickness="0,0,0,1"
											Padding="8">
										<Grid ColumnDefinitions="40,*,90,90,90,90,90,110,90,110,150"
											  ColumnSpacing="8">
											<TextBlock Grid.Column="0" Text="{Binding LineNumber}" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2"
													   Text="{Binding OpeningQty, StringFormat={}{0:N2}}"
													   TextAlignment="Right"
													   VerticalAlignment="Center"/>
											<NumericUpDown Grid.Column="3"
														   Value="{Binding BuyQty}"
														   Minimum="0"
														   FormatString="0.##"
														   HorizontalContentAlignment="Right"  ShowButtonSpinner="false" AllowSpin="false"  />
											<NumericUpDown Grid.Column="4"
														   Value="{Binding SellPosQty}"
														   Minimum="0"
														   FormatString="0.##"
														   HorizontalContentAlignment="Right"  ShowButtonSpinner="false" AllowSpin="false"  />
											<NumericUpDown Grid.Column="5"
														   Value="{Binding SellFullQty}"
														   Minimum="0"
														   FormatString="0.##"
														   HorizontalContentAlignment="Right"  ShowButtonSpinner="false" AllowSpin="false"  />
											<TextBlock Grid.Column="6"
													   Text="{Binding ClosingQty, StringFormat={}{0:N2}}"
													   FontWeight="SemiBold"
													   TextAlignment="Right"
													   VerticalAlignment="Center"/>
											<NumericUpDown Grid.Column="7"
														   Value="{Binding CostPrice}"
														   Minimum="0"
														   FormatString="0.##"
														   HorizontalContentAlignment="Right"  ShowButtonSpinner="false" AllowSpin="false"  />
											<NumericUpDown Grid.Column="8"
														   Value="{Binding SellPrice}"
														   Minimum="0"
														   FormatString="0.##"
														   HorizontalContentAlignment="Right"  ShowButtonSpinner="false" AllowSpin="false"  />
											<TextBlock Grid.Column="9"
													   Text="{Binding SalesAmount, StringFormat={}{0:N2}}"
													   TextAlignment="Right"
													   VerticalAlignment="Center"/>
											<TextBlock Grid.Column="10"
													   Text="{Binding ClosingValue, StringFormat={}{0:N2}}"
													   TextAlignment="Right"
													   VerticalAlignment="Center"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</ScrollViewer>

					<!-- Sticky Footer -->
					<Border Grid.Row="2" Background="{DynamicResource TableFooterBrush}" Padding="8" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
						<Grid ColumnDefinitions="*,18">
							<Grid ColumnDefinitions="40,*,90,90,90,90,90,110,90,110,150"
								  ColumnSpacing="8">
								<TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="รวม" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="9"
										   Text="{Binding TotalSalesAmount, StringFormat={}{0:N2}}"
										   FontWeight="Bold"
										   TextAlignment="Right"
										   VerticalAlignment="Center"/>
								<TextBlock Grid.Column="10"
										   Text="{Binding TotalClosingValue, StringFormat={}{0:N2}}"
										   FontWeight="Bold"
										   TextAlignment="Right"
										   VerticalAlignment="Center"/>
							</Grid>
						</Grid>
					</Border>

				</Grid>
			</ScrollViewer>
		</Border>

		<Grid Grid.Row="3" ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{Binding StatusMessage}"
					   FontStyle="Italic"
					   TextWrapping="Wrap"/>
			<ProgressBar Grid.Column="1"
						 Width="120"
						 IsIndeterminate="True"
						 IsVisible="{Binding IsBusy}"/>
		</Grid>
	</Grid>

</UserControl>
