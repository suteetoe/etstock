<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ETStock.Views.PdfPreviewWindow"
        Icon="avares://ETStock/Assets/etstock.ico"
        Title="พรีวิวใบกำกับภาษีอย่างย่อ"
        Width="760"
        Height="900"
        MinWidth="520"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="พิมพ์" Classes="accent" Click="Print_Click"/>
                    <Button Content="ปิด" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="14" Background="{DynamicResource PreviewChromeBrush}">
            <NativeWebView x:Name="WebView" />
        </Border>
    </Grid>
</Window>
