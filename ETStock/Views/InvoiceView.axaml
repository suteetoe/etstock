<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ETStock.ViewModels"
             xmlns:converters="using:ETStock.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ETStock.Views.InvoiceView"
             x:DataType="vm:InvoiceViewModel">

    <Design.DataContext>
        <vm:InvoiceViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8" Margin="12">

        <!-- Row 0: Toolbar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,90,Auto,60,Auto,*"
              ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="ปี (พ.ศ.)" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SelectedYear}"
                     IsEnabled="{Binding !IsBusy}"
                     HorizontalContentAlignment="Right"/>

            <TextBlock Grid.Column="2" Text="เดือน" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3"
                     Text="{Binding SelectedMonth}"
                     IsEnabled="{Binding !IsBusy}"
                     HorizontalContentAlignment="Right"/>

            <Button Grid.Column="4"
                    Content="โหลด"
                    Command="{Binding LoadCommand}"
                    IsEnabled="{Binding !IsBusy}"/>
        </Grid>

        <!-- Row 1: Latest running number (display-only) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="เล่มที่/เลขที่ล่าสุด" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding LatestRunningDisplay}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 2: Invoice list -->
        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="700">
                    <Border Background="#EEEEEE" Padding="8">
                        <Grid ColumnDefinitions="28,*,110,80,110,80,60,120" ColumnSpacing="8">
                            <TextBlock Grid.Column="1" Text="เลขที่ใบกำกับ" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="วันที่" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="เดือน" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="ยอดรวม" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="VAT" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="รายการ" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Invoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InvoiceRowViewModel">
                                <StackPanel>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="8">
                                        <Grid ColumnDefinitions="28,*,110,80,110,80,60,120" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Content="{Binding IsExpanded, Converter={x:Static converters:ExpandGlyphConverter.Instance}}"
                                                    Command="{Binding $parent[UserControl].((vm:InvoiceViewModel)DataContext).ToggleExpandCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding InvoiceNo}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding InvoiceDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TaxMonth}"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding TotalAmount, StringFormat='{}{0:N2}'}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding VatAmount, StringFormat='{}{0:N2}'}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding ItemCount}"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4">
                                                <Button Content="พิมพ์"
                                                        Command="{Binding $parent[UserControl].((vm:InvoiceViewModel)DataContext).PrintCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="4,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Detail panel: collapses/expands per invoice -->
                                    <Border IsVisible="{Binding IsExpanded}"
                                            Background="#FAFAFA"
                                            BorderBrush="#E5E5E5"
                                            BorderThickness="0,0,0,1"
                                            Padding="28,4,8,8">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,80,90,90" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="ชื่อสินค้า" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBlock Grid.Column="1" Text="จำนวน" FontWeight="SemiBold" Opacity="0.7" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="ยอดก่อน VAT" FontWeight="SemiBold" Opacity="0.7" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="VAT" FontWeight="SemiBold" Opacity="0.7" TextAlignment="Right"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:InvoiceItemDetailViewModel">
                                                        <Grid ColumnDefinitions="*,80,90,90" ColumnSpacing="8" Margin="0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat='{}{0:N0}'}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:N2}'}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding VatAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Summary footer -->
        <Border Grid.Row="3"
                Background="#F5F5F5"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="รวมช่วงนี้:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryCount, StringFormat='{}{0} ใบ'}" VerticalAlignment="Center"/>
                <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center"/>
                <TextBlock Text="ยอดรวม:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryTotal, StringFormat='{}{0:N2}'}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center"/>
                <TextBlock Text="VAT:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryVat, StringFormat='{}{0:N2}'}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Row 4: Status bar -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="1"
                         Width="120"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"/>
        </Grid>

    </Grid>

</UserControl>
